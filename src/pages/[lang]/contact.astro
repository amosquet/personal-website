---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "jp" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "jp" };
const t = useTranslations(lang);
---

<Layout title={t("navContact")} description={t("siteDescription")}>
    <p>Here</p>
</Layout>
