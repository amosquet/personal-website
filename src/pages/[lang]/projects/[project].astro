---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";
import projects from "@/data/projects.json";
import { getProjectSlug } from "@/utils/slugify";

export function getStaticPaths() {
    const langs = ["en", "fr", "ja"] as const;
    return langs.flatMap((lang) => {
        return projects.map((project) => ({
            params: { lang, project: getProjectSlug(project) },
            props: { project },
        }));
    });
}

const { lang } = Astro.params as { lang: "en" | "fr" | "ja" };
const { project } = Astro.props;
const t = useTranslations(lang);

const mainFields = ["name", "caption", "description", "slug"];
const additionalFields = Object.entries(project).filter(([key]) => !mainFields.includes(key));
const ogImage = `/${lang}/projects/${getProjectSlug(project)}/og.png`;
---

<Layout
    title={project.name}
    description={project.caption || project.description}
    image={ogImage}
>
    <div class="max-w-3xl mx-auto px-4 py-12">
        <a
            href={`/${lang}/projects`}
            class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 mb-10 inline-flex items-center gap-2 transition-colors font-medium"
        >
            &larr; {t("navProjects")}
        </a>

        <article>
            <header class="mb-10">
                <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-50 mb-2 tracking-tight">
                    {project.name}
                </h1>
                {project.caption && (
                    <p class="text-xl text-gray-600 dark:text-gray-400 font-normal">
                        {project.caption}
                    </p>
                )}
            </header>

            <div class="text-lg text-gray-800 dark:text-gray-200 leading-relaxed space-y-5">
                {project.description ? project.description.split('\n').map((paragraph: string) => (
                    <p>{paragraph}</p>
                )) : null}
            </div>

            {additionalFields.length > 0 && (
                <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800">
                    <h2 class="text-lg font-bold text-gray-900 dark:text-gray-50 mb-6">Details</h2>
                    <dl class="divide-y divide-gray-100 dark:divide-gray-800">
                        {additionalFields.map(([key, value]) => (
                            <div class="py-3 flex flex-col sm:flex-row sm:gap-4">
                                <dt class="text-gray-500 dark:text-gray-400 font-medium capitalize sm:w-1/3 shrink-0">
                                    {key.replace(/([A-Z])/g, ' $1').trim()}
                                </dt>
                                <dd class="text-gray-900 dark:text-gray-200 sm:w-2/3 mt-1 sm:mt-0">
                                    {Array.isArray(value) ? (
                                        <div class="flex flex-wrap gap-1.5">
                                            {value.map((item: string) => (
                                                <span class="px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-xs font-medium border border-gray-200 dark:border-gray-700">
                                                    {item}
                                                </span>
                                            ))}
                                        </div>
                                    ) : (typeof value === 'string' && value.startsWith('http')) ? (
                                        <a href={value} class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 hover:underline break-all" target="_blank" rel="noopener noreferrer">{value}</a>
                                    ) : (
                                        value
                                    )}
                                </dd>
                            </div>
                        ))}
                    </dl>
                </div>
            )}
        </article>
    </div>
</Layout>
