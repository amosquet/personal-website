---
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "ja" };

const { Content } = await import("@/content/now.md");
---

<Layout>
    <div class="max-w-2xl mx-auto py-16 px-6 font-mono text-sm leading-relaxed now-page">
        <Content />

        <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700 text-xs text-gray-400 dark:text-gray-500">
            <p>
                This is a{" "}
                <a
                    href="https://nownownow.com/about"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
                >
                    now page
                </a>
                .
            </p>
        </div>
    </div>
</Layout>

<style is:global>
    .now-page h1 {
        font-size: 1.25rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: -0.025em;
        border-bottom: 1px solid black;
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
    }

    [data-theme="dark"] .now-page h1 {
        border-bottom-color: #6b7280;
    }

    .now-page h2 {
        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
    }

    .now-page p {
        margin-bottom: 0.5rem;
    }

    .now-page ul {
        list-style: disc;
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .now-page hr {
        border-color: #e5e7eb;
        margin: 2.5rem 0;
    }

    [data-theme="dark"] .now-page hr {
        border-color: #374151;
    }

    .now-page a {
        text-decoration: underline;
        transition: color 0.2s;
    }

    .now-page a:hover {
        color: #2563eb;
    }

    [data-theme="dark"] .now-page a:hover {
        color: #60a5fa;
    }

    .now-page em {
        color: #9ca3af;
    }

    [data-theme="dark"] .now-page em {
        color: #6b7280;
    }

    .now-page strong {
        font-weight: 700;
    }
</style>
