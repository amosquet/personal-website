---
export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "ja" };

import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";
import { getBooks, type EnrichedBook } from "@/lib/books";

const t = useTranslations(lang);
const enrichedBooks: EnrichedBook[] = await getBooks();
---

<Layout
    title={t("navReading")}
    description={t("siteDescription")}
    image={`/${lang}/reading/og.png`}
>
    <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-50">
                <Fragment set:html={t("navReading")} />
            </h1>
            <a
                href={`/${lang}/reading/suggest`}
                class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-black dark:bg-gray-700 text-white hover:bg-gray-800 dark:hover:bg-gray-600 text-sm font-semibold transition-colors self-start sm:self-auto shadow-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <span>{t("suggestBook")}</span>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                enrichedBooks.map((book) => (
                    <a
                        href={`/${lang}/reading/${book.isbn}`}
                        class="block group"
                    >
                        <div class="border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm hover:border-blue-400 dark:hover:border-blue-500 transition-colors h-full flex flex-col">
                            {book.cover && (
                                <img
                                    src={book.cover}
                                    alt={`Cover of ${book.title}`}
                                    class="w-full h-48 object-contain mb-4 group-hover:scale-105 transition-transform"
                                />
                            )}
                            <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-1">
                                {book.title}
                            </h2>
                            <p class="text-gray-600 dark:text-gray-400 mb-4">{book.author}</p>

                            <div class="flex flex-col gap-2 mt-auto">
                                <div class="flex items-center justify-between text-xs font-bold">
                                    <span class="px-2.5 py-1 bg-blue-50 dark:bg-blue-900 text-blue-700 dark:text-blue-200 capitalize">
                                        {book.status}
                                    </span>
                                    <span class="text-gray-500 dark:text-gray-400">
                                        {book.publishDate}
                                    </span>
                                </div>
                                {
                                    (book.startDate || book.endDate || (book.status === "read" && book.completed)) && (
                                        <div class="text-[10px] text-gray-400 dark:text-gray-500 uppercase tracking-wider text-right font-bold">
                                            {book.endDate ? (
                                                <>
                                                    {t("finished")}: {book.endDate.substring(0, 10)}
                                                </>
                                            ) : book.status === "read" && book.completed ? (
                                                <>
                                                    {t("finished")}: {book.completed.substring(0, 10)}
                                                </>
                                            ) : (
                                                <>
                                                    {t("started")}: {book.startDate?.substring(0, 10)}
                                                </>
                                            )}
                                        </div>
                                    )
                                }
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <p class="text-xs text-gray-400 dark:text-gray-500 italic mt-12 text-center">
            {t("googleBooksCredit")}
        </p>
    </div>
</Layout>
