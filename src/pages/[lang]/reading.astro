---
export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "jp" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "jp" };

import Layout from "@/layouts/Layout.astro";
import readingData from "@/data/reading.json";
import { useTranslations } from "@/i18n/utils";
import pb, { authenticate } from "@/lib/pocketbase";
import type { RecordModel } from "pocketbase";

const t = useTranslations(lang);

interface BookRecord extends RecordModel {
    isbn: string;
    title: string;
    author: string;
    description: string;
    cover: string;
    publishDate: string;
}

interface EnrichedBook {
    isbn: string;
    title: string;
    author: string;
    status: string;
    startDate?: string;
    endDate?: string;
    completed?: string;
    publishDate: string;
    cover: string | null;
    description: string;
}

// Fetch data from PocketBase at build time
let enrichedBooks: EnrichedBook[] = [];
try {
    await authenticate();
    const pbBooks = await pb.collection("books").getFullList<BookRecord>();
    const pbBooksByIsbn = Object.fromEntries(pbBooks.map((b) => [b.isbn, b]));

    enrichedBooks = readingData.map((book: any) => {
        const pbBook = pbBooksByIsbn[book.isbn];
        const baseBook = {
            ...book,
            publishDate: pbBook?.publishDate || book.publishDate || "",
        };

        if (pbBook) {
            const coverUrl = pbBook.cover ? pb.files.getURL(pbBook, pbBook.cover) : null;
            if (coverUrl) {
                console.log(`[DEBUG] Generated cover URL for ${book.title}: ${coverUrl}`);
            }
            return {
                ...baseBook,
                title: pbBook.title || book.title,
                author: pbBook.author || book.author,
                cover: coverUrl,
                description: pbBook.description || "No description available.",
            } as EnrichedBook;
        }
        return {
            ...baseBook,
            cover: null,
            description: "No description available.",
        } as EnrichedBook;
    });
} catch (error) {
    console.error("Error fetching from PocketBase:", error);
    enrichedBooks = readingData.map((book: any) => ({
        ...book,
        publishDate: book.publishDate || "",
        cover: null,
        description: "No description available.",
    } as EnrichedBook));
}
---

<Layout>
    <div class="max-w-5xl mx-auto px-4 py-12">
        <h1 class="text-3xl font-bold mb-8 text-gray-900">
            <Fragment set:html={t("navReading")} />
        </h1>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                enrichedBooks.map((book) => (
                    <a
                        href={`/${lang}/reading/${book.isbn}`}
                        class="block group"
                    >
                        <div class="border border-gray-200 p-6 bg-white shadow-sm hover:border-blue-400 transition-colors h-full">
                            {book.cover && (
                                <img
                                    src={book.cover}
                                    alt={`Cover of ${book.title}`}
                                    class="w-full h-48 object-contain mb-4 group-hover:scale-105 transition-transform"
                                />
                            )}
                            <h2 class="text-xl font-bold text-gray-900 mb-1">
                                {book.title}
                            </h2>
                            <p class="text-gray-600 mb-4">{book.author}</p>

                            <div
                                class="text-sm text-gray-700 line-clamp-3 mb-4"
                                set:html={book.description}
                            />

                            <div class="flex flex-col gap-2 mt-auto">
                                <div class="flex items-center justify-between text-xs font-bold">
                                    <span class="px-2.5 py-1 bg-blue-50 text-blue-700 capitalize">
                                        {book.status}
                                    </span>
                                    <span class="text-gray-500">
                                        {book.publishDate}
                                    </span>
                                </div>
                                {
                                    (book.startDate || book.endDate || (book.status === "read" && book.completed)) && (
                                        <div class="text-[10px] text-gray-400 uppercase tracking-wider text-right font-bold">
                                            {book.endDate ? (
                                                <>
                                                    {t("finished")}: {book.endDate}
                                                </>
                                            ) : book.status === "read" && book.completed ? (
                                                <>
                                                    {t("finished")}: {book.completed}
                                                </>
                                            ) : (
                                                <>
                                                    {t("started")}: {book.startDate}
                                                </>
                                            )}
                                        </div>
                                    )
                                }
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <p class="text-xs text-gray-400 italic mt-12 text-center">
            {t("googleBooksCredit")}
        </p>
    </div>
</Layout>
