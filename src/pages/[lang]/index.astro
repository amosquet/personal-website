---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@/i18n/utils";
import { getCollection } from "astro:content";
import { getBooks, type EnrichedBook } from "@/lib/books";
import projects from "@/data/projects.json";
import hardwareData from "@/data/hardware.json";
import { getProjectSlug } from "@/utils/slugify";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "jp" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "jp" };
const t = useTranslations(lang);

// 1. Featured Project (Shisho Companion Android or first in list)
const featuredProject =
    projects.find((p) => p.name.toLowerCase().includes("shisho companion")) ||
    projects[0];

// 2. Latest Blog Post (filtered by lang, fallback to en/all if none in current lang)
const allPosts = await getCollection("blog", ({ data }) => {
    return import.meta.env.DEV || !data.draft;
});
const localizedPosts = allPosts.filter((p) => p.id.startsWith(`${lang}/`));
const postsToDisplay = localizedPosts.length > 0 ? localizedPosts : allPosts;
const sortedPosts = postsToDisplay.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latestPost = sortedPosts.length > 0 ? sortedPosts[0] : null;

const dateLocale = lang === "jp" ? "ja-JP" : lang === "fr" ? "fr-FR" : "en-US";
const latestPostDate = latestPost
    ? new Intl.DateTimeFormat(dateLocale, {
          year: "numeric",
          month: "short",
          day: "numeric",
      }).format(latestPost.data.pubDate)
    : "";
const latestPostSlug = latestPost
    ? latestPost.id.includes("/")
        ? latestPost.id.split("/")[1]
        : latestPost.id
    : "";

// 3. Currently Reading Book
const books: EnrichedBook[] = await getBooks();
const currentBook =
    books.find(
        (b) =>
            b.status?.toLowerCase() === "reading" ||
            b.status?.toLowerCase() === "currently-reading",
    ) ||
    books.find(
        (b) => b.startDate && !b.endDate && b.status?.toLowerCase() !== "read",
    ) ||
    (books.length > 0 ? books[0] : null);

// 4. Preview Devices for condensed Daily Drivers
const previewDevices = hardwareData.slice(0, 3);
---

<Layout description={t("siteDescription")}>
    <div class="max-w-5xl mx-auto py-10 px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-fr">
            {/* 1. Hero Card (2 cols) */}
            <section class="md:col-span-2 border border-gray-200 bg-white p-7 shadow-xs flex flex-col justify-between">
                <div>
                    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3 tracking-tight">
                        {t("helloThere")}
                    </h1>
                    <p
                        class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl"
                        set:html={t("introText")}
                    />
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-6 pt-5 border-t border-gray-100">
                    <div class="flex items-center gap-3">
                        <a
                            href="https://github.com/amosquet"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-2 text-gray-600 hover:text-black hover:bg-gray-100 transition-colors"
                            aria-label="GitHub"
                        >
                            <Icon name="mdi:github" class="w-6 h-6" />
                        </a>
                        <a
                            href="https://www.linkedin.com/in/artusmosquet"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-2 text-gray-600 hover:text-black hover:bg-gray-100 transition-colors"
                            aria-label="LinkedIn"
                        >
                            <Icon name="mdi:linkedin" class="w-6 h-6" />
                        </a>
                        <a
                            href="mailto:contact@amcloud.dev"
                            class="p-2 text-gray-600 hover:text-black hover:bg-gray-100 transition-colors"
                            aria-label="Email"
                        >
                            <Icon name="mdi:email" class="w-6 h-6" />
                        </a>
                        <a
                            href="/Artus_Mosquet_Resume.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-2 text-gray-600 hover:text-black hover:bg-gray-100 transition-colors"
                            aria-label="Resume (PDF)"
                            title="Resume (PDF)"
                        >
                            <Icon
                                name="mdi:file-document-outline"
                                class="w-6 h-6"
                            />
                        </a>
                    </div>

                    <a
                        href={`/${lang}/about`}
                        class="text-xs font-semibold text-gray-700 hover:text-black inline-flex items-center gap-1.5 transition-colors"
                    >
                        <span>{t("navAbout")}</span>
                        <Icon name="mdi:arrow-right" class="w-4 h-4" />
                    </a>
                </div>
            </section>

            {/* 2. What I'm Doing Now Card (1 col) */}
            <section class="border border-gray-200 bg-white p-6 shadow-xs flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500">
                            <Fragment set:html={t("nowTitle")} />
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-gray-100 text-gray-800 border border-gray-200">
                            <span class="h-1.5 w-1.5 bg-gray-900 animate-pulse"></span>
                            {t("nowStatus")}
                        </span>
                    </div>

                    <ul class="text-xs sm:text-sm text-gray-700 space-y-3">
                        <li class="flex items-start gap-2.5">
                            <span class="text-gray-400 mt-0.5">🎓</span>
                            <span set:html={t("nowPurdue")} />
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-gray-400 mt-0.5">⚡</span>
                            <span set:html={t("nowOrganiser")} />
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-gray-400 mt-0.5">🖥️</span>
                            <span set:html={t("nowHomelab")} />
                        </li>
                    </ul>
                </div>

                <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-[11px] text-gray-400">
                        West Lafayette, IN
                    </span>
                    <a href={`/${lang}/now`} class="text-[11px] font-medium text-gray-500 hover:text-gray-900 transition-colors flex items-center gap-1">
                        <span>Now</span>
                        <Icon name="mdi:arrow-right" class="w-3 h-3" />
                    </a>
                </div>
            </section>

            {/* 3. Featured Project Card (1 col) */}
            <article class="border border-gray-200 bg-white p-6 shadow-xs hover:border-gray-900 transition-colors flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 flex items-center gap-1.5">
                            <Icon
                                name="mdi:rocket-launch-outline"
                                class="w-4 h-4 text-gray-500"
                            />
                            <Fragment set:html={t("featuredProjectTitle")} />
                        </span>
                    </div>
                    <a
                        href={`/${lang}/projects/${getProjectSlug(featuredProject)}`}
                        class="block"
                    >
                        <h2 class="text-lg font-bold text-gray-900 group-hover:text-black mb-1 transition-colors">
                            {featuredProject.name}
                        </h2>
                        <p class="text-xs text-gray-500 mb-3 font-medium">
                            {featuredProject.caption}
                        </p>
                        <p class="text-xs sm:text-sm text-gray-600 line-clamp-2 mb-4 leading-relaxed">
                            {featuredProject.description}
                        </p>
                    </a>

                    {featuredProject.techStack && (
                        <div class="flex flex-wrap gap-1.5 mb-4">
                            {featuredProject.techStack
                                .slice(0, 3)
                                .map((tech) => (
                                    <span class="px-2 py-0.5 bg-gray-100 text-gray-700 text-[11px] font-medium border border-gray-100">
                                        {tech}
                                    </span>
                                ))}
                        </div>
                    )}
                </div>

                <a
                    href={`/${lang}/projects`}
                    class="text-xs font-semibold text-gray-600 group-hover:text-black inline-flex items-center gap-1.5 transition-colors pt-3 border-t border-gray-100"
                >
                    <Fragment set:html={t("viewAllProjects")} />
                </a>
            </article>

            {/* 4. Latest Blog Post Card (1 col) */}
            <article class="border border-gray-200 bg-white p-6 shadow-xs hover:border-gray-900 transition-colors flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 flex items-center gap-1.5">
                            <Icon
                                name="mdi:newspaper-variant-outline"
                                class="w-4 h-4 text-gray-500"
                            />
                            <Fragment set:html={t("latestPostTitle")} />
                        </span>
                        {latestPostDate && (
                            <time class="text-[11px] text-gray-400 font-medium">
                                {latestPostDate}
                            </time>
                        )}
                    </div>

                    {latestPost ? (
                        <a
                            href={`/${lang}/blog/${latestPostSlug}`}
                            class="block"
                        >
                            <h2 class="text-lg font-bold text-gray-900 group-hover:text-black mb-2 transition-colors">
                                {latestPost.data.title}
                            </h2>
                            <p class="text-xs sm:text-sm text-gray-600 line-clamp-3 mb-4 leading-relaxed">
                                {latestPost.data.description}
                            </p>
                            {latestPost.data.tags &&
                                latestPost.data.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-1.5 mb-4">
                                        {latestPost.data.tags
                                            .slice(0, 3)
                                            .map((tag) => (
                                                <span class="px-2 py-0.5 bg-gray-100 text-gray-700 text-[11px] font-medium border border-gray-100">
                                                    #{tag}
                                                </span>
                                            ))}
                                    </div>
                                )}
                        </a>
                    ) : (
                        <p class="text-xs text-gray-500 italic py-4">
                            {t("noPostsFound")}
                        </p>
                    )}
                </div>

                <a
                    href={`/${lang}/blog`}
                    class="text-xs font-semibold text-gray-600 group-hover:text-black inline-flex items-center gap-1.5 transition-colors pt-3 border-t border-gray-100"
                >
                    <Fragment set:html={t("readArticle")} />
                </a>
            </article>

            {/* 5. Currently Reading Card (1 col) */}
            <article class="border border-gray-200 bg-white p-6 shadow-xs hover:border-gray-900 transition-colors flex flex-col justify-between group">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 flex items-center gap-1.5">
                            <Icon
                                name="mdi:book-open-page-variant-outline"
                                class="w-4 h-4 text-gray-500"
                            />
                            <Fragment set:html={t("currentlyReadingTitle")} />
                        </span>
                        {currentBook && (
                            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-gray-100 text-gray-700 border border-gray-200">
                                {currentBook.status}
                            </span>
                        )}
                    </div>

                    {currentBook ? (
                        <a
                            href={`/${lang}/reading/${currentBook.isbn}`}
                            class="block my-1"
                        >
                            <div class="flex gap-4 items-start">
                                {currentBook.cover ? (
                                    <div class="w-24 sm:w-28 shrink-0 aspect-2/3 overflow-hidden flex items-center justify-center">
                                        <img
                                            src={currentBook.cover}
                                            alt={currentBook.title}
                                            class="w-full h-full object-contain"
                                        />
                                    </div>
                                ) : (
                                    <div class="w-24 sm:w-28 shrink-0 aspect-2/3 flex items-center justify-center text-gray-400">
                                        <Icon name="mdi:book" class="w-8 h-8" />
                                    </div>
                                )}
                                <div class="min-w-0 flex flex-col justify-between self-stretch py-0.5">
                                    <div>
                                        <h2 class="text-base font-bold text-gray-900 group-hover:text-black transition-colors line-clamp-3 leading-snug">
                                            {currentBook.title}
                                        </h2>
                                        <p class="text-xs text-gray-500 font-medium mt-1 truncate">
                                            {currentBook.author}
                                        </p>
                                        {currentBook.publishDate && (
                                            <p class="text-[11px] text-gray-400 mt-1 font-medium">
                                                {currentBook.publishDate.substring(
                                                    0,
                                                    4,
                                                )}
                                            </p>
                                        )}
                                    </div>

                                    <div class="flex flex-col gap-1 mt-3 pt-2 border-t border-gray-50">
                                        {currentBook.startDate && (
                                            <div class="text-[11px] text-gray-600 font-medium">
                                                <span class="text-[10px] text-gray-400 uppercase tracking-wider block font-semibold">
                                                    {t("started")}
                                                </span>
                                                {currentBook.startDate.substring(
                                                    0,
                                                    10,
                                                )}
                                            </div>
                                        )}
                                        {currentBook.isbn && (
                                            <span class="text-[10px] font-mono text-gray-400 truncate">
                                                ISBN {currentBook.isbn}
                                            </span>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </a>
                    ) : (
                        <p
                            class="text-xs text-gray-500 italic py-4"
                            set:html={t("noActiveBook")}
                        />
                    )}
                </div>

                <a
                    href={`/${lang}/reading`}
                    class="text-xs font-semibold text-gray-600 group-hover:text-black inline-flex items-center gap-1.5 transition-colors pt-3 border-t border-gray-100"
                >
                    <Fragment set:html={t("viewReadingList")} />
                </a>
            </article>

            {/* 6. Condensed Daily Drivers Card (2 cols) */}
            <section class="md:col-span-2 border border-gray-200 bg-white p-6 shadow-xs flex flex-col justify-between">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-gray-100">
                    <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                        <Icon
                            name="mdi:laptop-account"
                            class="w-5 h-5 text-gray-700"
                        />
                        <Fragment set:html={t("dailyDrivers")} />
                    </h2>
                    <a
                        href={`/${lang}/hardware`}
                        class="text-xs font-semibold text-gray-600 hover:text-black transition-colors inline-flex items-center gap-1"
                    >
                        <Fragment set:html={t("exploreHardware")} />
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 my-4">
                    {previewDevices.map((device) => (
                        <div class="p-3.5 bg-gray-50 border border-gray-100 flex items-center gap-3 hover:border-gray-300 transition-colors">
                            <span class="p-2 bg-white text-gray-800 border border-gray-200 shrink-0">
                                <Icon name={device.icon} class="w-5 h-5" />
                            </span>
                            <div class="min-w-0">
                                <h3 class="font-bold text-gray-900 text-xs sm:text-sm truncate">
                                    {device.name}
                                </h3>
                                <p class="text-[11px] text-gray-500 truncate">
                                    {device.specs["OS"]}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>

                <div class="flex items-center justify-between text-[11px] text-gray-400 pt-2 border-t border-gray-50">
                    <span>Arch Linux • macOS • Android</span>
                    <a
                        href={`/${lang}/hardware`}
                        class="hover:underline text-gray-500 font-medium"
                    >
                        + 3 more devices
                    </a>
                </div>
            </section>

            {/* 7. Homelab & Infrastructure Card (1 col) */}
            <section class="border border-gray-200 bg-white p-6 shadow-xs flex flex-col justify-between group hover:border-gray-900 transition-colors">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <span class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500 uppercase tracking-wider">
                            <span class="h-2 w-2 bg-emerald-500"></span>
                            <Fragment set:html={t("allSystemsOperational")} />
                        </span>
                        <Icon
                            name="mdi:server-network"
                            class="w-5 h-5 text-gray-400 group-hover:text-black transition-colors"
                        />
                    </div>

                    <div class="space-y-3">
                        <div>
                            <div class="text-2xl font-black text-gray-900 tracking-tight">
                                20TB+
                            </div>
                            <p
                                class="text-xs text-gray-500"
                                set:html={t("dataStored")}
                            />
                        </div>
                        <div class="h-px bg-gray-100"></div>
                        <div>
                            <div class="text-lg font-bold text-gray-900">
                                1TB+/mo
                            </div>
                            <p
                                class="text-xs text-gray-500"
                                set:html={t("networkTraffic")}
                            />
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-gray-100">
                    <a
                        href="https://status.amcloud.dev"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs text-gray-500 group-hover:text-black flex items-center justify-between transition-colors font-mono"
                    >
                        <span>status.amcloud.dev</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </section>
        </div>
    </div>
</Layout>
