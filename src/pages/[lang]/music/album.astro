---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@/i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "fr" } },
    { params: { lang: "ja" } },
  ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "ja" };
const t = useTranslations(lang);
const apiUrl =
  import.meta.env.PUBLIC_SHISHO_API_URL || "https://shisho.amcloud.dev";
---

<Layout
  title={`${t("musicKindAlbum")} | ${t("musicPageTitle")}`}
  description={t("musicPageSubtitle")}
  image={`/${lang}/music/og.png`}
  type="music.album"
>
  <div class="max-w-5xl mx-auto px-4 py-12 space-y-10">
    <!-- Back to Music navigation -->
    <div>
      <a
        href={`/${lang}/music`}
        class="text-gray-500 dark:text-gray-400 hover:text-black dark:hover:text-white inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider transition-colors"
      >
        &larr; <Fragment set:html={t("backToMusic")} />
      </a>
    </div>

    <!-- 1. Loading Skeleton -->
    <div id="album-skeleton" class="space-y-8 animate-pulse">
      <div class="border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 sm:p-8 flex flex-col md:flex-row gap-6 sm:gap-8 items-start">
        <div class="w-44 h-44 sm:w-56 sm:h-56 bg-gray-100 dark:bg-gray-700 shrink-0" />
        <div class="flex-1 w-full space-y-4">
          <div class="h-5 bg-gray-200 dark:bg-gray-700 w-1/4" />
          <div class="h-9 bg-gray-200 dark:bg-gray-600 w-3/4" />
          <div class="h-5 bg-gray-100 dark:bg-gray-700 w-1/2" />
          <div class="h-4 bg-gray-100 dark:bg-gray-700 w-1/3 pt-2" />
          <div class="flex gap-3 pt-4">
            <div class="h-9 w-28 bg-gray-200 dark:bg-gray-700" />
            <div class="h-9 w-28 bg-gray-200 dark:bg-gray-700" />
          </div>
        </div>
      </div>

      <div class="border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 space-y-4">
        <div class="h-5 bg-gray-200 dark:bg-gray-700 w-1/6 mb-4" />
        {
          [1, 2, 3, 4, 5, 6].map(() => (
            <div class="flex items-center justify-between py-2 border-b border-gray-100 dark:border-gray-700/60">
              <div class="h-4 bg-gray-100 dark:bg-gray-700 w-1/3" />
              <div class="h-4 bg-gray-100 dark:bg-gray-700 w-16" />
            </div>
          ))
        }
      </div>
    </div>

    <!-- 2. Error / Not Found State -->
    <div
      id="album-error"
      class="hidden border border-dashed border-gray-300 dark:border-gray-700 p-12 text-center bg-white dark:bg-gray-800"
      role="alert"
    >
      <div class="w-12 h-12 mx-auto mb-4 text-gray-400 dark:text-gray-500 flex items-center justify-center">
        <Icon name="mdi:album" class="w-12 h-12" />
      </div>
      <h2
        id="album-error-title"
        class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2"
      >
        <Fragment set:html={t("albumNotFound")} />
      </h2>
      <p
        id="album-error-desc"
        class="text-sm text-gray-500 dark:text-gray-400 max-w-md mx-auto mb-6"
      >
        <Fragment set:html={t("albumNotFoundDesc")} />
      </p>
      <a
        href={`/${lang}/music`}
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-black dark:bg-gray-100 text-white dark:text-gray-900 text-xs font-semibold hover:bg-gray-800 dark:hover:bg-gray-300 transition-colors"
      >
        &larr; <Fragment set:html={t("backToMusic")} />
      </a>
    </div>

    <!-- 3. Loaded Album Content -->
    <article id="album-content" class="hidden space-y-10" aria-live="polite">
      <!-- Album Hero Card -->
      <header class="border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 sm:p-8 flex flex-col md:flex-row gap-6 sm:gap-8 shadow-xs">
        <!-- Cover Art -->
        <div class="w-44 h-44 sm:w-56 sm:h-56 shrink-0 aspect-square border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50 overflow-hidden flex items-center justify-center relative shadow-xs">
          <img
            id="album-cover-img"
            src=""
            alt=""
            class="w-full h-full object-cover hidden"
          />
          <div
            id="album-cover-fallback"
            class="flex items-center justify-center text-gray-400 dark:text-gray-500"
          >
            <Icon name="mdi:album" class="w-20 h-20" />
          </div>
        </div>

        <!-- Metadata & Actions -->
        <div class="flex-1 flex flex-col justify-between min-w-0">
          <div>
            <!-- Badges -->
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                {t("musicKindAlbum")}
              </span>
              <span
                id="album-year-badge"
                class="hidden px-2 py-0.5 text-[10px] font-mono bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300"
              ></span>
              <span
                id="album-quality-badge"
                class="hidden px-2 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-700/60"
              ></span>
            </div>

            <!-- Title & Artist -->
            <h1
              id="album-title"
              class="text-2xl sm:text-3xl md:text-4xl font-black text-gray-900 dark:text-gray-50 tracking-tight leading-tight"
            ></h1>
            <p
              id="album-artist"
              class="text-base sm:text-lg font-medium text-gray-600 dark:text-gray-300 mt-1"
            ></p>

            <!-- Meta statistics (tracks, runtime, plays, genres) -->
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/80 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500 dark:text-gray-400">
              <span id="album-track-count" class="font-medium"></span>
              <span class="text-gray-300 dark:text-gray-600">•</span>
              <span id="album-duration" class="font-mono"></span>
              <span id="album-plays-separator" class="hidden text-gray-300 dark:text-gray-600">•</span>
              <span id="album-plays-count" class="hidden font-mono"></span>
            </div>

            <!-- Genres -->
            <div id="album-genres-wrapper" class="hidden mt-3 flex flex-wrap gap-1.5"></div>

            <!-- Summary / Editorial review -->
            <div
              id="album-summary-wrapper"
              class="hidden mt-4 pt-3 border-t border-gray-100 dark:border-gray-700/60 text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl line-clamp-4 hover:line-clamp-none transition-all"
            ></div>
          </div>

          <!-- Action Buttons -->
          <div id="album-actions-wrapper" class="mt-6 flex flex-wrap items-center gap-3">
            <a
              id="album-youtube-btn"
              href=""
              target="_blank"
              rel="noopener noreferrer"
              class="hidden inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800/60 hover:bg-red-100 dark:hover:bg-red-900/50 transition-colors"
            >
              <Icon name="simple-icons:youtubemusic" class="w-4 h-4 text-red-600 dark:text-red-400" />
              <span>{t("listenOnYoutubeMusic")}</span>
              <span class="text-xs">↗</span>
            </a>

            <a
              id="album-qobuz-btn"
              href=""
              target="_blank"
              rel="noopener noreferrer"
              class="hidden inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold bg-sky-50 dark:bg-sky-950/40 text-sky-800 dark:text-sky-300 border border-sky-200 dark:border-sky-800/60 hover:bg-sky-100 dark:hover:bg-sky-900/50 transition-colors"
            >
              <Icon name="mdi:music" class="w-4 h-4 text-sky-600 dark:text-sky-400" />
              <span>{t("listenOnQobuz")}</span>
              <span class="text-xs">↗</span>
            </a>
          </div>
        </div>
      </header>

      <!-- Tracklist Section -->
      <section aria-labelledby="tracklist-heading" class="border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xs">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
          <h2
            id="tracklist-heading"
            class="text-base font-bold text-gray-900 dark:text-gray-50 flex items-center gap-2"
          >
            <Icon name="mdi:format-list-numbered" class="w-5 h-5 text-gray-500 dark:text-gray-400" />
            <Fragment set:html={t("albumTracks")} />
          </h2>
          <span
            id="tracklist-summary-count"
            class="text-xs font-mono text-gray-400 dark:text-gray-500"
          ></span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-gray-50 dark:bg-gray-700/40 border-b border-gray-200 dark:border-gray-700 text-[11px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">
              <tr>
                <th scope="col" class="py-3 px-4 w-12 text-center">{t("trackNumber")}</th>
                <th scope="col" class="py-3 px-4">{t("trackTitle")}</th>
                <th scope="col" class="py-3 px-4 hidden sm:table-cell">{t("hardwareSpecs") || "Format"}</th>
                <th scope="col" class="py-3 px-4 hidden md:table-cell text-right">{t("trackPlays")}</th>
                <th scope="col" class="py-3 px-4 text-right w-20">{t("trackDuration")}</th>
              </tr>
            </thead>
            <tbody id="tracklist-body" class="divide-y divide-gray-100 dark:divide-gray-700/60">
            </tbody>
          </table>
        </div>
      </section>
    </article>
  </div>
</Layout>

<script
  is:inline
  define:vars={{
    lang,
    apiUrl,
    playsCountLabel: t("playsCount"),
  }}
>
  (() => {
    const baseUrl = (apiUrl || "").replace(/\/$/, "");
    const params = new URLSearchParams(window.location.search);
    const albumId = (params.get("id") || "").trim();

    const skeletonEl = document.getElementById("album-skeleton");
    const errorEl = document.getElementById("album-error");
    const contentEl = document.getElementById("album-content");

    const coverImg = document.getElementById("album-cover-img");
    const coverFallback = document.getElementById("album-cover-fallback");
    const titleEl = document.getElementById("album-title");
    const artistEl = document.getElementById("album-artist");
    const yearBadge = document.getElementById("album-year-badge");
    const qualityBadge = document.getElementById("album-quality-badge");
    const trackCountEl = document.getElementById("album-track-count");
    const durationEl = document.getElementById("album-duration");
    const playsSeparator = document.getElementById("album-plays-separator");
    const playsCountEl = document.getElementById("album-plays-count");
    const genresWrapper = document.getElementById("album-genres-wrapper");
    const summaryWrapper = document.getElementById("album-summary-wrapper");
    const youtubeBtn = document.getElementById("album-youtube-btn");
    const qobuzBtn = document.getElementById("album-qobuz-btn");
    const tracklistBody = document.getElementById("tracklist-body");
    const tracklistSummaryCount = document.getElementById("tracklist-summary-count");

    function escapeHtml(str) {
      if (!str) return "";
      const d = document.createElement("div");
      d.textContent = String(str);
      return d.innerHTML;
    }

    function resolveCoverUrl(url) {
      if (!url) return "";
      if (url.startsWith("http")) return url;
      return `${baseUrl}${url.startsWith("/") ? "" : "/"}${url}`;
    }

    function formatDuration(ms) {
      const totalSeconds = Math.max(0, Math.floor((ms || 0) / 1000));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      const paddedSec = seconds < 10 ? `0${seconds}` : `${seconds}`;
      if (hours > 0) {
        const paddedMin = minutes < 10 ? `0${minutes}` : `${minutes}`;
        return `${hours}:${paddedMin}:${paddedSec}`;
      }
      return `${minutes}:${paddedSec}`;
    }

    function formatLongDuration(ms) {
      const totalSeconds = Math.max(0, Math.floor((ms || 0) / 1000));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      if (hours > 0) {
        return `${hours} hr ${minutes} min`;
      }
      return `${minutes} min ${seconds} sec`;
    }

    function showError() {
      if (skeletonEl) skeletonEl.classList.add("hidden");
      if (contentEl) contentEl.classList.add("hidden");
      if (errorEl) errorEl.classList.remove("hidden");
    }

    async function loadAlbum() {
      if (!albumId) {
        showError();
        return;
      }

      try {
        const res = await fetch(`${baseUrl}/api/plex/album?id=${encodeURIComponent(albumId)}`);
        if (!res.ok) {
          showError();
          return;
        }

        const album = await res.json();
        if (!album || !album.title) {
          showError();
          return;
        }

        // Update document title dynamically
        document.title = `${album.title} — ${album.artist} | Music`;

        // Render Cover
        const cover = resolveCoverUrl(album.cover_url);
        if (cover && coverImg && coverFallback) {
          coverImg.alt = `${album.title} album cover`;
          coverImg.onload = () => {
            coverImg.classList.remove("hidden");
            coverFallback.classList.add("hidden");
          };
          coverImg.onerror = () => {
            coverImg.classList.add("hidden");
            coverFallback.classList.remove("hidden");
          };
          coverImg.src = cover;
        }

        // Title and Artist
        if (titleEl) titleEl.textContent = album.title || "Untitled Album";
        if (artistEl) {
          const artistName = album.artist || "Unknown Artist";
          if (album.artist_rating_key) {
            artistEl.innerHTML = `<a href="/${lang}/music/artist?id=${encodeURIComponent(album.artist_rating_key)}" class="hover:underline hover:text-gray-900 dark:hover:text-gray-100 transition-colors">${escapeHtml(artistName)}</a>`;
          } else {
            artistEl.textContent = artistName;
          }
        }

        // Badges
        if (yearBadge) {
          if (album.year) {
            yearBadge.textContent = String(album.year);
            yearBadge.classList.remove("hidden");
          } else {
            yearBadge.classList.add("hidden");
          }
        }

        if (qualityBadge) {
          if (album.audio_quality) {
            qualityBadge.textContent = album.audio_quality;
            qualityBadge.classList.remove("hidden");
          } else {
            qualityBadge.classList.add("hidden");
          }
        }

        // Stats
        const trackCount = (album.tracks || []).length || album.track_count || 0;
        if (trackCountEl) {
          trackCountEl.textContent = `${trackCount} ${trackCount === 1 ? "track" : "tracks"}`;
        }
        if (tracklistSummaryCount) {
          tracklistSummaryCount.textContent = `${trackCount} ${trackCount === 1 ? "track" : "tracks"}`;
        }

        if (durationEl && album.total_duration_ms) {
          durationEl.textContent = formatLongDuration(album.total_duration_ms);
        }

        const plays = Number(album.view_count) || 0;
        if (plays > 0 && playsCountEl && playsSeparator) {
          playsCountEl.textContent = `${plays} ${playsCountLabel}`;
          playsCountEl.classList.remove("hidden");
          playsSeparator.classList.remove("hidden");
        }

        // Genres
        if (genresWrapper && Array.isArray(album.genres) && album.genres.length > 0) {
          genresWrapper.innerHTML = album.genres
            .map(
              (g) =>
                `<span class="px-2 py-0.5 text-[10px] font-medium bg-gray-100 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300">${escapeHtml(g)}</span>`
            )
            .join("");
          genresWrapper.classList.remove("hidden");
        }

        // Summary
        if (summaryWrapper && album.summary) {
          summaryWrapper.textContent = album.summary;
          summaryWrapper.classList.remove("hidden");
        }

        // Action Buttons
        if (youtubeBtn) {
          const ytUrl = album.youtube_music_url || album.youtube_url;
          if (ytUrl) {
            youtubeBtn.href = ytUrl;
            youtubeBtn.classList.remove("hidden");
          } else {
            youtubeBtn.classList.add("hidden");
          }
        }

        if (qobuzBtn) {
          if (album.qobuz_url) {
            qobuzBtn.href = album.qobuz_url;
            qobuzBtn.classList.remove("hidden");
          } else {
            qobuzBtn.classList.add("hidden");
          }
        }

        // Tracklist Table
        if (tracklistBody && Array.isArray(album.tracks)) {
          tracklistBody.innerHTML = album.tracks
            .map((track, idx) => {
              const num = track.index || (idx + 1);
              const title = escapeHtml(track.title || "Untitled Track");
              const artistSub =
                track.artist && track.artist !== album.artist
                  ? `<div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">${escapeHtml(track.artist)}</div>`
                  : "";
              const formatBadge = track.audio_quality || track.audio_codec || "";
              const formatHtml = formatBadge
                ? `<span class="px-1.5 py-0.5 text-[10px] font-mono bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">${escapeHtml(formatBadge)}</span>`
                : `<span class="text-gray-400 dark:text-gray-600">-</span>`;
              const trackPlays = Number(track.view_count) || 0;
              const playsHtml =
                trackPlays > 0
                  ? `<span class="font-mono text-gray-600 dark:text-gray-300">${trackPlays}</span>`
                  : `<span class="text-gray-400 dark:text-gray-600">-</span>`;
              const dur = track.duration_ms ? formatDuration(track.duration_ms) : "-";

              return `
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                  <td class="py-3 px-4 text-center font-mono text-gray-400 dark:text-gray-500">${escapeHtml(String(num))}</td>
                  <td class="py-3 px-4">
                    <div class="font-semibold text-gray-900 dark:text-gray-50">${title}</div>
                    ${artistSub}
                  </td>
                  <td class="py-3 px-4 hidden sm:table-cell">${formatHtml}</td>
                  <td class="py-3 px-4 hidden md:table-cell text-right">${playsHtml}</td>
                  <td class="py-3 px-4 text-right font-mono text-gray-500 dark:text-gray-400">${dur}</td>
                </tr>
              `;
            })
            .join("");
        }

        // Hide skeleton and reveal content
        if (skeletonEl) skeletonEl.classList.add("hidden");
        if (contentEl) contentEl.classList.remove("hidden");
      } catch (err) {
        showError();
      }
    }

    loadAlbum();
  })();
</script>
