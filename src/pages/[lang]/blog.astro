---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "jp" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "jp" };
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ id, data }) => {
    const matchesLang = id.startsWith(`${lang}/`);
    return (import.meta.env.DEV || !data.draft) && matchesLang;
});

const posts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title={t("navBlog")}>
    <div class="max-w-4xl mx-auto px-4 py-12">
        <header class="mb-10">
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">
                {t("navBlog")}
            </h1>
        </header>

        {
            posts.length === 0 ? (
                <div class="border border-dashed border-gray-300 p-12 text-center text-gray-500">
                    <p class="text-base">{t("noPostsFound")}</p>
                </div>
            ) : (
                <div class="space-y-6">
                    {posts.map((post) => {
                        const slug = post.id.replace(`${lang}/`, "");
                        const dateLocale =
                            lang === "jp" ? "ja-JP" : lang === "fr" ? "fr-FR" : "en-US";
                        const formattedDate = new Intl.DateTimeFormat(dateLocale, {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        }).format(post.data.pubDate);

                        return (
                            <article class="border border-gray-200 p-6 bg-white shadow-sm hover:border-blue-400 transition-colors">
                                <a href={`/${lang}/blog/${slug}`} class="block group">
                                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                                        <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                                            {post.data.title}
                                        </h2>
                                        <time
                                            datetime={post.data.pubDate.toISOString()}
                                            class="text-xs text-gray-500 shrink-0"
                                        >
                                            {formattedDate}
                                        </time>
                                    </div>
                                    <p class="text-gray-600 mb-4 line-clamp-2">
                                        {post.data.description}
                                    </p>
                                    {post.data.tags && post.data.tags.length > 0 && (
                                        <div class="flex flex-wrap gap-2">
                                            {post.data.tags.map((tag) => (
                                                <span class="text-xs px-2.5 py-0.5 bg-gray-100 text-gray-600 rounded-full font-medium">
                                                    #{tag}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                </a>
                            </article>
                        );
                    })}
                </div>
            )
        }
    </div>
</Layout>
