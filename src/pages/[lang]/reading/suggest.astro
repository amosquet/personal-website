---
export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "jp" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "jp" };

import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";
import BookSuggestForm from "@/components/BookSuggestForm.astro";
import CommunitySuggestions from "@/components/CommunitySuggestions.astro";

const t = useTranslations(lang);
---

<Layout title={t("suggestBook")}>
    <div class="max-w-5xl mx-auto px-4 py-12">
        <a
            href={`/${lang}/reading`}
            class="text-blue-600 hover:underline mb-8 inline-flex items-center gap-1.5 text-sm font-medium"
        >
            &larr; <Fragment set:html={t("navReading")} />
        </a>

        <div class="mb-10 text-center max-w-2xl mx-auto">
            <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
                {t("suggestBook")}
            </h1>
            <p class="text-base text-gray-600">
                {t("suggestBookDesc")}
            </p>
        </div>

        <div class="mb-16">
            <BookSuggestForm lang={lang} />
        </div>

        <div class="border-t border-gray-200 pt-12">
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-2">
                    {t("tabSuggestions")}
                </h2>
                <p class="text-sm text-gray-500">
                    {lang === "fr"
                        ? "Livres recommandés par les visiteurs."
                        : lang === "jp"
                        ? "訪問者から提案された本の一覧です。"
                        : "Books recommended by website visitors."}
                </p>
            </div>

            <CommunitySuggestions lang={lang} />
        </div>
    </div>
</Layout>
