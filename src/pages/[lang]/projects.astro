---
import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/i18n/utils";
import { getProjectSlug } from "@/utils/slugify";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "ja" };
const t = useTranslations(lang);

import projects from "@/data/projects.json";
---

<Layout
    title={t("navProjects")}
    description={t("siteDescription")}
    image={`/${lang}/projects/og.png`}
>
    <div class="max-w-5xl mx-auto px-4 py-12">
        <h1 class="text-3xl font-bold mb-8 text-gray-900 dark:text-gray-50">
            {t("navProjects")}
        </h1>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                projects.map((project) => (
                    <a
                        href={`/${lang}/projects/${getProjectSlug(project)}`}
                        class="block group"
                    >
                        <div class="border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm hover:border-blue-400 dark:hover:border-blue-500 transition-colors h-full">
                            <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-1">
                                {project.name}
                            </h2>
                            <p class="text-gray-600 dark:text-gray-400">{project.caption}</p>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
