<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>Artus Mosquet</title>
        <meta name="description" content="Personal website of Artus Mosquet, Full-Time ECE Student at Purdue University." />
        <link rel="canonical" href="https://artusmosquet.com/en/" />
        <link rel="alternate" hreflang="en" href="https://artusmosquet.com/en/" />
        <link rel="alternate" hreflang="fr" href="https://artusmosquet.com/fr/" />
        <link rel="alternate" hreflang="ja" href="https://artusmosquet.com/jp/" />
        <link rel="alternate" hreflang="x-default" href="https://artusmosquet.com/en/" />
        <meta property="og:site_name" content="Artus Mosquet" />
        <meta property="og:title" content="Artus Mosquet" />
        <meta property="og:description" content="Personal website of Artus Mosquet, Full-Time ECE Student at Purdue University." />
        <meta property="og:url" content="https://artusmosquet.com/" />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="https://artusmosquet.com/og-image.png" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:locale:alternate" content="fr_FR" />
        <meta property="og:locale:alternate" content="ja_JP" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Artus Mosquet" />
        <meta name="twitter:description" content="Personal website of Artus Mosquet, Full-Time ECE Student at Purdue University." />
        <meta name="twitter:image" content="https://artusmosquet.com/og-image.png" />
        <script>
            const supportedLocales = ["en", "fr", "jp"];
            const defaultLocale = "en";

            // Extract the primary language tag (e.g., 'ja-JP' becomes 'ja')
            const browserLang = navigator.language.split("-")[0];

            // Map standard browser language codes to internal route names
            const langMapping: Record<string, string> = {
                ja: "jp",
            };

            // Apply the mapping if it exists, otherwise use the raw browser language
            const mappedLang = langMapping[browserLang] || browserLang;

            const targetLocale = supportedLocales.includes(mappedLang)
                ? mappedLang
                : defaultLocale;

            window.location.replace(`/${targetLocale}/`);
        </script>
    </head>
    <body>
        <noscript>
            <meta http-equiv="refresh" content="0;url=/en/" />
            <p>
                Redirecting to <a href="/en/">the default site</a>...
            </p>
        </noscript>
    </body>
</html>
