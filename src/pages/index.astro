---
import AboutLayout from "@/layouts/AboutLayout.astro";
import translations from "@/i18n/about.json";
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
        { params: { lang: "jp" } },
    ];
}

const { lang } = Astro.params as { lang: "en" | "fr" | "jp" };

import hardwareData from "@/data/hardware.json";
// import TimeWidget from "@/components/Clock.astro";

const sectionTitle = "Daily Drivers"; //Placeholder
---

<Layout>
    <div class="max-w-5xl mx-auto py-12 px-4">
        <div
            class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[minmax(180px,auto)]"
        >
            <div
                class="md:col-span-2 bg-gradient-to-br from-blue-50 to-indigo-100 p-8 rounded-3xl border border-blue-200 flex flex-col justify-center"
            >
                <h1 class="text-4xl font-bold text-gray-900 mb-4">
                    Hello Here! 👋
                </h1>
                <p class="text-xl text-gray-700">
                    I'm a Full-Time ECE Student at Purdue. I speak French and
                    English, and I enjoy working on web development projects.
                </p>
            </div>

            <div
                class="bg-gray-900 text-white p-8 rounded-3xl flex flex-col justify-center items-center text-center shadow-lg hover:scale-[1.02] transition-transform"
            >
                <Icon
                    name="mdi:server-network"
                    class="w-12 h-12 mb-4 text-blue-400"
                />
                <div
                    class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400"
                >
                    20TB+
                </div>
                <p class="text-sm text-gray-400 mt-2">Data Stored</p>
                <div class="w-full h-px bg-gray-800 my-3"></div>
                <div class="text-xl font-bold text-gray-200">1TB+/mo</div>
                <p class="text-sm text-gray-400">Network Traffic</p>
            </div>

            <div
                class="md:col-span-2 bg-white p-8 rounded-3xl border border-gray-200 shadow-sm"
            >
                <h2
                    class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2"
                >
                    <Icon
                        name="mdi:laptop-account"
                        class="w-6 h-6 text-gray-600"
                    />
                    {sectionTitle}
                </h2>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    {
                        hardwareData.map((device) => (
                            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 flex flex-col gap-3 hover:border-blue-200 transition-colors">
                                <div class="flex items-center gap-2 border-b border-gray-200 pb-2">
                                    <Icon
                                        name={device.icon}
                                        class="w-5 h-5 text-gray-700"
                                    />
                                    <h3 class="font-semibold text-gray-900">
                                        {device.name}
                                    </h3>
                                </div>
                                <ul class="text-sm text-gray-600 space-y-1.5">
                                    {Object.entries(device.specs).map(
                                        ([key, value]) => (
                                            <li class="flex justify-between gap-4">
                                                <span class="font-medium text-gray-500">
                                                    {key}
                                                </span>
                                                <span class="text-right">
                                                    {value}
                                                </span>
                                            </li>
                                        ),
                                    )}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</Layout>
