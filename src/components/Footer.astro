---
import { defaultLocale } from "@/i18n/i18n";
const locale = Astro.currentLocale || defaultLocale;
import { useTranslations } from "@/i18n/utils";
const t = useTranslations(locale);

import { Icon } from "astro-icon/components";

const git = "github";
const git_username = "amosquet";
const twitter = "twitter";
const twitter_username = "Almondmanttv";
const twitch = "twitch";
const twitch_username = "Almondmanttv";
---

<style>
    footer {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
</style>

<footer>
    {t("footerProject")}
    <a href="https://www.github.com/amosquet" aria-label="GitHub">
        <Icon
            name="simple-icons:github"
            class="w-8 h-8 text-gray-800 hover:text-blue-600 transition-colors"
        />
    </a>
    {t("footerSocial")}
    <a href={`https://www.twitter.com/almondmanttv`}>Twitter</a>, <a
        href={`https://www.twitch.tv/almondmanttv`}>Twitch</a
    >!
</footer>
<p>© 2025 {t("siteTitle")}</p>
