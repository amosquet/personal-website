---
import { defaultLocale } from "@/i18n/i18n";
import { uiStrings } from "@/i18n/uiStrings";
const locale = Astro.currentLocale || defaultLocale;
import { useTranslations } from "@/i18n/utils";
const t = useTranslations(locale);

import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import purdueHackers from "@/assets/purdue-hackers.svg";

// import "@/assets/purdue-hackers.svg";
---

<footer class="mt-20 border-t border-gray-100 py-8 bg-white">
    <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 items-center gap-6">
        
        <!-- Copyright, FAQ & Privacy Policy -->
        <div class="text-gray-400 text-xs font-medium order-3 md:order-1 flex flex-wrap justify-center md:justify-start items-center gap-3">
            <span>© 2025 {t("siteTitle")}</span>
            <span class="text-gray-300">•</span>
            <a href={`/${locale}/faq`} class="hover:text-black transition-colors">
                {uiStrings.faq[locale]}
            </a>
            <span class="text-gray-300">•</span>
            <a href={`/${locale}/privacy`} class="hover:text-black transition-colors">
                {t("privacyPolicy")}
            </a>
        </div>

        <!-- Purdue Hackers Webring -->
        <div class="order-1 md:order-2 flex justify-center items-center">
            <div class="flex items-center gap-3 py-1.5 px-4 bg-gray-50 rounded-full border border-gray-100 text-xs text-gray-500">
                <a href="https://ring.purduehackers.com/previous" class="hover:text-blue-600 transition-colors font-bold">←</a>
                <a href="https://ring.purduehackers.com/" class="flex items-center">
                    <Image src={purdueHackers} alt="Purdue Hackers Webring" class="w-4 h-4 rounded-full" />
                </a>
                <a href="https://ring.purduehackers.com/next" class="hover:text-blue-600 transition-colors font-bold">→</a>
            </div>
        </div>

        <!-- Social Links -->
        <div class="order-2 md:order-3 flex justify-center md:justify-end items-center gap-4">
            <a href="https://github.com/amosquet" aria-label="GitHub" class="text-gray-400 hover:text-black transition-colors">
                <Icon name="simple-icons:github" class="w-5 h-5" />
            </a>
            <a href="https://twitter.com/almondmanttv" aria-label="Twitter" class="text-gray-400 hover:text-blue-400 transition-colors">
                <Icon name="simple-icons:twitter" class="w-5 h-5" />
            </a>
            <a href="https://twitch.tv/almondmanttv" aria-label="Twitch" class="text-gray-400 hover:text-purple-600 transition-colors">
                <Icon name="simple-icons:twitch" class="w-5 h-5" />
            </a>
        </div>
        
    </div>
</footer>
