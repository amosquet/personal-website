---

import { defaultLocale } from "@/i18n/i18n";
import { uiStrings } from "@/i18n/uiStrings";
const locale = Astro.currentLocale || defaultLocale;


const git = "github";
const git_username = "amosquet";
const twitter = "twitter";
const twitter_username = "Almondmanttv";
const twitch = "twitch";
const twitch_username = "Almondmanttv";
---

<footer>
    <p>{uiStrings["footerProject"]![locale]} <a href={`https://www.github.com/amosquet`}>{git}</a>!</p>
    <p>{uiStrings["footerSocial"]![locale]} <a href={`https://www.twitter.com/almondmanttv`}>Twitter</a>, <a href={`https://www.twitch.tv/almondmanttv`}>Twitch</a>!</p>
    <p>© 2025 {uiStrings["siteTitle"]![locale]}</p>
</footer>