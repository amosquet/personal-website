---

import { defaultLocale } from "@/i18n/i18n";
const locale = Astro.currentLocale || defaultLocale;
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(locale);


const git = "github";
const git_username = "amosquet";
const twitter = "twitter";
const twitter_username = "Almondmanttv";
const twitch = "twitch";
const twitch_username = "Almondmanttv";
---

<style>
    footer {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }
</style>

<footer>
    <p>{t("footerProject")} <a href={`https://www.github.com/amosquet`}>{git}</a>!</p>
    <p>{t("footerSocial")} <a href={`https://www.twitter.com/almondmanttv`}>Twitter</a>, <a href={`https://www.twitch.tv/almondmanttv`}>Twitch</a>!</p>
    <p>© 2025 {t("siteTitle")}</p>
</footer>