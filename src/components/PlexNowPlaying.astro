---
import { Icon } from "astro-icon/components";
import { defaultLocale, type Locale } from "@/i18n/i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Locale;
  class?: string;
  showCrateLink?: boolean;
}

const { lang, class: className = "", showCrateLink = true } = Astro.props;
const locale = lang || (Astro.currentLocale as Locale) || defaultLocale;
const t = useTranslations(locale);
const apiUrl =
  import.meta.env.PUBLIC_SHISHO_API_URL || "https://shisho.amcloud.dev";
---

<section
  id="plex-now-playing-card"
  class:list={[
    "border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 shadow-xs hover:border-gray-900 dark:hover:border-gray-400 transition-colors flex flex-col justify-between group",
    className,
  ]}
  aria-live="polite"
>
  <div>
    <!-- Header -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span
        class="text-[11px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 flex items-center gap-1.5"
      >
        <Icon
          name="mdi:headphones"
          class="w-4 h-4 text-gray-500 dark:text-gray-400"
        />
        <Fragment set:html={t("nowPlayingTitle")} />
      </span>

      <div class="flex items-center gap-2">
        <span
          id="plex-audio-quality"
          class="hidden px-2 py-0.5 text-[10px] font-mono font-semibold uppercase tracking-wider bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-700/60"
        ></span>

        <span
          id="plex-status-badge"
          class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-600"
        >
          <span
            id="plex-status-dot"
            class="h-1.5 w-1.5 bg-gray-400 dark:bg-gray-500"
          ></span>
          <span id="plex-status-text" set:html={t("plexIdle")} />
        </span>
      </div>
    </div>

    <!-- Active / Last Played Track View -->
    <div id="plex-track-container" class="hidden">
      <div class="flex gap-4 items-center">
        <!-- Cover Art -->
        <div
          class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/60 overflow-hidden flex items-center justify-center relative"
        >
          <img
            id="plex-cover-img"
            alt=""
            class="w-full h-full object-cover hidden"
          />
          <div
            id="plex-cover-fallback"
            class="flex items-center justify-center text-gray-400 dark:text-gray-500"
          >
            <Icon name="mdi:album" class="w-9 h-9" />
          </div>
        </div>

        <!-- Track Metadata -->
        <div class="min-w-0 flex-1">
          <h2
            id="plex-track-title"
            class="text-base sm:text-lg font-bold text-gray-900 dark:text-gray-50 truncate leading-snug"
          >
          </h2>
          <p
            id="plex-track-artist"
            class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 font-medium mt-0.5 truncate"
          >
          </p>
          <p
            id="plex-track-album"
            class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 truncate"
          >
          </p>
        </div>
      </div>

      <!-- Progress Bar -->
      <div id="plex-progress-wrapper" class="mt-4">
        <div
          class="w-full h-1.5 bg-gray-100 dark:bg-gray-700 overflow-hidden border border-gray-200/60 dark:border-gray-600/60"
          role="progressbar"
          id="plex-progressbar-role"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-label="Track playback progress"
        >
          <div
            id="plex-progress-bar"
            class="h-full bg-gray-900 dark:bg-gray-100 transition-[width] duration-500 ease-linear"
            style="width: 0%"
          >
          </div>
        </div>
        <div
          class="flex items-center justify-between text-[11px] font-mono text-gray-500 dark:text-gray-400 mt-1.5"
        >
          <span id="plex-time-current">0:00</span>
          <span id="plex-time-total">0:00</span>
        </div>
      </div>
    </div>

    <!-- Empty / Idle State (when no active session and no last-played track) -->
    <div
      id="plex-empty-container"
      class="py-4 flex items-center gap-3.5 text-gray-500 dark:text-gray-400"
    >
      <div
        class="w-12 h-12 shrink-0 bg-gray-50 dark:bg-gray-700/60 border border-gray-200 dark:border-gray-600 flex items-center justify-center text-gray-400 dark:text-gray-500"
      >
        <Icon name="mdi:music-off" class="w-6 h-6" />
      </div>
      <p class="text-xs sm:text-sm italic leading-relaxed" set:html={t("plexNotPlaying")} />
    </div>
  </div>

  <!-- Footer -->
  <div
    class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between gap-2 text-xs text-gray-500 dark:text-gray-400"
  >
    {
      showCrateLink ? (
        <a
          href={`/${locale}/music`}
          class="text-xs font-semibold text-gray-600 dark:text-gray-400 group-hover:text-black dark:group-hover:text-white inline-flex items-center gap-1.5 transition-colors"
        >
          <Icon name="mdi:plex" class="w-4 h-4 text-amber-500 shrink-0" />
          <Fragment set:html={t("exploreMusicCrate")} />
        </a>
      ) : (
        <span class="flex items-center gap-1.5 font-medium">
          <Icon name="mdi:plex" class="w-4 h-4 text-amber-500 shrink-0" />
          <span id="plex-footer-label" set:html={t("plexStreamingVia")} />
        </span>
      )
    }
    <span
      id="plex-player-name"
      class="font-mono text-[11px] text-gray-400 dark:text-gray-500 truncate max-w-[160px]"
    >
      Plex
    </span>
  </div>
</section>

<script
  is:inline
  define:vars={{
    apiUrl,
    labelPlaying: t("plexPlaying"),
    labelPaused: t("plexPaused"),
    labelIdle: t("plexIdle"),
    labelLastPlayed: t("plexLastPlayed"),
  }}
>
  (() => {
    const statusDot = document.getElementById("plex-status-dot");
    const statusText = document.getElementById("plex-status-text");
    const qualityEl = document.getElementById("plex-audio-quality");
    const trackContainer = document.getElementById("plex-track-container");
    const emptyContainer = document.getElementById("plex-empty-container");
    const coverImg = document.getElementById("plex-cover-img");
    const coverFallback = document.getElementById("plex-cover-fallback");
    const titleEl = document.getElementById("plex-track-title");
    const artistEl = document.getElementById("plex-track-artist");
    const albumEl = document.getElementById("plex-track-album");
    const progressWrapper = document.getElementById("plex-progress-wrapper");
    const progressRole = document.getElementById("plex-progressbar-role");
    const progressBar = document.getElementById("plex-progress-bar");
    const timeCurrentEl = document.getElementById("plex-time-current");
    const timeTotalEl = document.getElementById("plex-time-total");
    const playerNameEl = document.getElementById("plex-player-name");

    if (!trackContainer || !emptyContainer) return;

    const baseUrl = (apiUrl || "").replace(/\/$/, "");
    let currentState = "stopped";
    let progressMs = 0;
    let durationMs = 0;
    let lastTickAt = Date.now();
    let currentCoverUrl = "";
    let isFetching = false;

    function formatTime(ms) {
      const totalSeconds = Math.max(0, Math.floor((ms || 0) / 1000));
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      const paddedSec = seconds < 10 ? `0${seconds}` : `${seconds}`;
      if (hours > 0) {
        const paddedMin = minutes < 10 ? `0${minutes}` : `${minutes}`;
        return `${hours}:${paddedMin}:${paddedSec}`;
      }
      return `${minutes}:${paddedSec}`;
    }

    function updateProgressUI() {
      if (!progressBar || !timeCurrentEl || !timeTotalEl) return;
      const pct =
        durationMs > 0
          ? Math.min(100, Math.max(0, (progressMs / durationMs) * 100))
          : 0;
      progressBar.style.width = `${pct.toFixed(2)}%`;
      if (progressRole) {
        progressRole.setAttribute("aria-valuenow", String(Math.round(pct)));
      }
      timeCurrentEl.textContent = formatTime(progressMs);
      timeTotalEl.textContent = formatTime(durationMs);
    }

    function setBadge(state, hasTrack) {
      if (!statusDot || !statusText) return;
      statusDot.className = "h-1.5 w-1.5";
      if (state === "playing" || state === "buffering") {
        statusDot.classList.add("bg-emerald-500", "animate-pulse");
        statusText.innerHTML = labelPlaying;
      } else if (state === "paused") {
        statusDot.classList.add("bg-amber-500");
        statusText.innerHTML = labelPaused;
      } else if (hasTrack) {
        statusDot.classList.add("bg-gray-400", "dark:bg-gray-500");
        statusText.innerHTML = labelLastPlayed;
      } else {
        statusDot.classList.add("bg-gray-400", "dark:bg-gray-500");
        statusText.innerHTML = labelIdle;
      }
    }

    function renderState(data) {
      const state = (data && data.state) || "stopped";
      const track = (data && data.track) || null;
      currentState = state;
      lastTickAt = Date.now();

      setBadge(state, Boolean(track));

      if (!track) {
        trackContainer.classList.add("hidden");
        emptyContainer.classList.remove("hidden");
        if (playerNameEl) playerNameEl.textContent = "Plex";
        if (qualityEl) qualityEl.classList.add("hidden");
        return;
      }

      emptyContainer.classList.add("hidden");
      trackContainer.classList.remove("hidden");

      if (titleEl) titleEl.textContent = track.title || "Untitled Track";
      if (artistEl) artistEl.textContent = track.artist || "Unknown Artist";
      if (albumEl) {
        const albumParts = [];
        if (track.album) albumParts.push(track.album);
        if (track.year) albumParts.push(`(${track.year})`);
        albumEl.textContent = albumParts.join(" ");
      }

      if (qualityEl) {
        if (track.audio_quality) {
          qualityEl.textContent = track.audio_quality;
          qualityEl.classList.remove("hidden");
        } else {
          qualityEl.textContent = "";
          qualityEl.classList.add("hidden");
        }
      }

      if (playerNameEl) {
        playerNameEl.textContent = track.player || "Plex";
      }

      // Cover Art handling
      let resolvedCover = "";
      if (track.cover_url) {
        resolvedCover = track.cover_url.startsWith("http")
          ? track.cover_url
          : `${baseUrl}${track.cover_url.startsWith("/") ? "" : "/"}${track.cover_url}`;
      }

      if (coverImg && coverFallback) {
        if (resolvedCover) {
          coverImg.alt = track.album || track.title || "Album cover";
          coverImg.onload = () => {
            coverImg.classList.remove("hidden");
            coverFallback.classList.add("hidden");
          };
          coverImg.onerror = () => {
            coverImg.classList.add("hidden");
            coverFallback.classList.remove("hidden");
          };
          if (currentCoverUrl !== resolvedCover) {
            currentCoverUrl = resolvedCover;
            coverImg.src = resolvedCover;
          } else if (coverImg.complete && coverImg.naturalWidth > 0) {
            coverImg.classList.remove("hidden");
            coverFallback.classList.add("hidden");
          }
        } else {
          currentCoverUrl = "";
          coverImg.removeAttribute("src");
          coverImg.classList.add("hidden");
          coverFallback.classList.remove("hidden");
        }
      }

      durationMs = Number(track.duration_ms) || 0;
      progressMs = Number(track.progress_ms) || 0;

      if (progressWrapper) {
        if (durationMs > 0) {
          progressWrapper.classList.remove("hidden");
          updateProgressUI();
        } else {
          progressWrapper.classList.add("hidden");
        }
      }
    }

    async function fetchNowPlaying() {
      if (isFetching || document.hidden) return;
      isFetching = true;
      try {
        const res = await fetch(`${baseUrl}/api/plex/now-playing`, {
          headers: { Accept: "application/json" },
        });
        if (!res.ok) return;
        const data = await res.json();
        renderState(data);
      } catch (_) {
        // Silently retain previous state on network hiccup
      } finally {
        isFetching = false;
      }
    }

    // Smooth 1s client-side progress interpolation while playing
    const tickInterval = setInterval(() => {
      if (currentState === "playing" && durationMs > 0 && !document.hidden) {
        const now = Date.now();
        const delta = Math.max(0, now - lastTickAt);
        lastTickAt = now;
        progressMs = Math.min(durationMs, progressMs + delta);
        updateProgressUI();

        // When track reaches the end, poll immediately for the next track
        if (progressMs >= durationMs) {
          fetchNowPlaying();
        }
      } else {
        lastTickAt = Date.now();
      }
    }, 1000);

    // Poll API every 10 seconds
    const pollInterval = setInterval(fetchNowPlaying, 10000);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {
        lastTickAt = Date.now();
        fetchNowPlaying();
      }
    });

    // Clean up intervals on Astro page navigation if applicable
    document.addEventListener(
      "astro:before-swap",
      () => {
        clearInterval(tickInterval);
        clearInterval(pollInterval);
      },
      { once: true }
    );

    fetchNowPlaying();
  })();
</script>
