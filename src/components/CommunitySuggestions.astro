---
import { defaultLocale, type Locale } from "@/i18n/i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang } = Astro.props;
const locale = lang || (Astro.currentLocale as Locale) || defaultLocale;
const t = useTranslations(locale);
const apiUrl = import.meta.env.PUBLIC_SHISHO_API_URL || "https://shisho.amcloud.dev";
---

<div id="community-suggestions-section" class="w-full">
  <!-- Error Alert -->
  <div
    id="suggestions-error-alert"
    class="hidden p-4 mb-6 border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-sm flex items-center justify-between"
    role="alert"
  >
    <span id="suggestions-error-text"></span>
    <button
      type="button"
      id="retry-suggestions-btn"
      class="underline font-semibold hover:text-red-900 dark:hover:text-red-200 ml-4 cursor-pointer"
    >
      {t("retry")}
    </button>
  </div>

  <!-- Cards Container -->
  <div
    id="suggestions-grid"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    aria-live="polite"
  >
    <!-- Initial Loading Skeleton -->
    {
      [1, 2, 3].map(() => (
        <div class="border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm h-full flex flex-col animate-pulse">
          <div class="w-full h-48 bg-gray-100 dark:bg-gray-700 mb-4"></div>
          <div class="h-6 bg-gray-200 dark:bg-gray-600 w-3/4 mb-2"></div>
          <div class="h-4 bg-gray-100 dark:bg-gray-700 w-1/2 mb-4"></div>
          <div class="h-12 bg-gray-50 dark:bg-gray-700/50 w-full mb-4"></div>
          <div class="mt-auto h-4 bg-gray-100 dark:bg-gray-700 w-1/3"></div>
        </div>
      ))
    }
  </div>
</div>


<script is:inline define:vars={{
  apiUrl,
  emptyText: t("noSuggestions"),
  suggestBtnText: t("suggestBook"),
  suggestedByText: t("suggestedBy"),
  suggestedOnText: t("suggestedOn"),
  viaText: t("viaSource"),
  errorGeneric: t("suggestNetworkError"),
}}>
  (() => {
    const grid = document.getElementById("suggestions-grid");
    const errorAlert = document.getElementById("suggestions-error-alert");
    const errorText = document.getElementById("suggestions-error-text");
    const retryBtn = document.getElementById("retry-suggestions-btn");

    if (!grid) return;

    let hasLoadedOnce = false;

    async function fetchSuggestions() {
      if (!errorAlert || !errorText) return;
      errorAlert.classList.add("hidden");

      try {
        const baseUrl = apiUrl.replace(/\/$/, "");
        const res = await fetch(`${baseUrl}/api/books/suggestions`);
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const data = await res.json();
        const books = data.books || [];

        renderBooks(books);
        hasLoadedOnce = true;
      } catch (err) {
        console.error("Failed to load suggested books:", err);
        errorText.textContent = errorGeneric;
        errorAlert.classList.remove("hidden");
        if (!hasLoadedOnce) {
          grid.innerHTML = "";
        }
      }
    }

    function escapeHtml(str) {
      if (!str) return "";
      const d = document.createElement("div");
      d.textContent = str;
      return d.innerHTML;
    }

    function renderBooks(books) {
      if (!books || books.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full border border-dashed border-gray-300 dark:border-gray-600 p-12 text-center bg-gray-50 dark:bg-gray-800/50">
            <p class="text-gray-600 dark:text-gray-400 mb-4">${escapeHtml(emptyText)}</p>
            <button
              type="button"
              data-open-suggest-modal
              class="px-5 py-2 bg-black dark:bg-gray-100 text-white dark:text-gray-900 hover:bg-gray-800 dark:hover:bg-gray-300 text-sm font-semibold transition-colors cursor-pointer"
            >
              + ${escapeHtml(suggestBtnText)}
            </button>
          </div>
        `;
        return;
      }

      grid.innerHTML = books
        .map((b) => {
          const title = escapeHtml(b.title || (b.isbn ? `ISBN: ${b.isbn}` : "Untitled"));
          const author = b.author ? `<p class="text-gray-600 dark:text-gray-400 mb-2">${escapeHtml(b.author)}</p>` : "";
          const reason = b.message
            ? `<blockquote class="text-sm text-gray-700 dark:text-gray-300 italic border-l-2 border-blue-400 dark:border-blue-500 pl-3 py-1 my-3 bg-blue-50/40 dark:bg-blue-900/20">"${escapeHtml(
                b.message
              )}"</blockquote>`
            : "";

          const cleanDate = b.date_suggested ? b.date_suggested.split(" ")[0] : "";
          const dateStr = cleanDate ? `<span>${escapeHtml(suggestedOnText)} ${escapeHtml(cleanDate)}</span>` : "";
          const sourceStr = b.suggested_from
            ? `<span class="text-blue-600 dark:text-blue-400 font-medium">${escapeHtml(viaText)} ${escapeHtml(b.suggested_from)}</span>`
            : "";

          const isbnTag = b.isbn
            ? `<span class="font-mono text-[11px] bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 px-2 py-0.5">${escapeHtml(b.isbn)}</span>`
            : "";

          const coverMarkup = b.cover_url
            ? `<div class="w-full h-48 flex items-center justify-center mb-4 bg-gray-50 dark:bg-gray-700/50 overflow-hidden">
                <img
                  src="${escapeHtml(b.cover_url)}"
                  alt="Cover of ${title}"
                  class="w-full h-48 object-contain transition-transform hover:scale-105"
                  loading="lazy"
                  onerror="this.parentElement.style.display='none'"
                />
              </div>`
            : "";

          return `
            <div class="border border-gray-200 dark:border-gray-700 p-6 bg-white dark:bg-gray-800 shadow-sm hover:border-blue-400 dark:hover:border-blue-500 transition-colors h-full flex flex-col">
              ${coverMarkup}
              <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-1">${title}</h2>
              ${author}
              ${reason}

              <div class="flex flex-col gap-2 mt-auto pt-3 border-t border-gray-100 dark:border-gray-700 text-xs text-gray-500 dark:text-gray-400">
                <div class="flex items-center justify-between">
                  ${isbnTag}
                  ${sourceStr}
                </div>
                ${dateStr ? `<div class="text-[11px] text-gray-400 dark:text-gray-500 text-right">${dateStr}</div>` : ""}
              </div>
            </div>
          `;
        })
        .join("");
    }


    retryBtn?.addEventListener("click", fetchSuggestions);

    // Initial load
    fetchSuggestions();

    // Re-fetch automatically when a book is suggested via the modal
    document.addEventListener("book-suggested", () => {
      fetchSuggestions();
    });
  })();
</script>
