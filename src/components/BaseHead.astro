---
import { defaultLocale, locales } from "@/i18n/i18n";
import { uiStrings } from "@/i18n/uiStrings";
const locale = Astro.currentLocale || defaultLocale;
import { useTranslations } from "@/i18n/utils";
const t = useTranslations(locale);
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;
---

<style>
    nav {
        background-color: black;
        width: 100%;
    }
    .nav-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 64rem; /* 5xl */
        margin: 0 auto;
        padding: 20px 16px; /* Keeps consistent padding */
    }
    .name {
        color: white;
        font-size: 1.25rem;
        font-weight: bold;
        margin-right: auto; /* Pushes the links to the right */
    }
    a {
        color: white;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
    .links {
        display: flex;
        gap: 16px; /* Keeps consistent spacing between links */
        align-items: center;
    }

    /* Dropdown container */
    .language-dropdown {
        position: relative;
        display: inline-block;
    }

    /* Dropdown button */
    .dropbtn {
        background: none;
        border: none;
        color: white;
        text-decoration: none;
        font-size: 1rem;
        font-family: inherit;
        cursor: pointer;
        text-transform: uppercase;
    }

    .dropbtn:hover {
        text-decoration: underline;
    }

    /* Dropdown content (hidden by default) */
    .language-dropdown-content {
        display: none;
        position: absolute;
        background-color: black;
        min-width: 50px;
        box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
        z-index: 1;
        right: 0;
        border: 1px solid #333;
        border-radius: 4px;
    }

    /* Links inside the dropdown */
    .language-dropdown-content a {
        padding: 12px 16px;
        display: block;
        text-align: left;
        text-transform: uppercase;
    }

    /* Show the dropdown menu on hover */
    .language-dropdown:hover .language-dropdown-content {
        display: block;
    }
</style>

<nav>
    <div class="nav-container">
        <div class="name">{t("siteTitle")}</div>
        <div class="links">
            <a href={"/" + locale + "/"}>{uiStrings["navHome"]![locale]}</a>
            <!-- <a href={"/" + locale + "/blog/"}>{uiStrings["navBlog"]![locale]}</a> -->
            <a href={"/" + locale + "/about/"}>{uiStrings["navAbout"]![locale]}</a>
            <!-- <a href={"/" + locale + "/contact/"}
                >{uiStrings["navContact"]![locale]}</a
            > -->
            <!-- <a
                href="mailto:contact@amcloud.dev"
                aria-label="Send Email"
                class="text-gray-600 hover:text-blue-600 transition-colors flex items-center"
            >
                <Icon name="mdi:email" class="w-6 h-6" />
            </a> -->

            <a
                href={`/${locale}/reading`}
                class="flex items-center gap-2 hover:text-blue-600 transition-colors group"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="square"
                    stroke-linejoin="miter"
                    class="opacity-80"
                >
                    <rect x="4" y="2" width="16" height="20"></rect>
                    <line x1="8" y1="2" x2="8" y2="22"></line>
                    <line x1="12" y1="6" x2="16" y2="6"></line>
                    <line x1="12" y1="10" x2="16" y2="10"></line>
                </svg>

                <span set:html={t("navReading")} />
            </a>

            <a
                href="https://status.amcloud.dev"
                target="_blank"
                rel="noopener noreferrer"
            >
                {uiStrings["status"]![locale]}
            </a>

            <div class="language-dropdown">
                <button class="dropbtn">{locale}</button>
                <div class="language-dropdown-content">
                    {
                        locales.map((otherLocale) => {
                            if (otherLocale === locale) return null;
                            const newPath = currentPath.replace(
                                `/${locale}/`,
                                `/${otherLocale}/`,
                            );
                            return <a href={newPath}>{otherLocale}</a>;
                        })
                    }
                </div>
            </div>
        </div>
    </div>
</nav>
