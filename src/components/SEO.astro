---
import { defaultLocale, locales, type Locale } from "@/i18n/i18n";
import { uiStrings } from "@/i18n/uiStrings";
import { cleanText } from "@/utils/cleanText";
export { cleanText };

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "book" | string;
  noindex?: boolean;
  availableLocales?: readonly string[];
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  book?: {
    author?: string;
    isbn?: string;
  };
}

const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
  availableLocales,
  article,
  book,
} = Astro.props;

const activeLocales = availableLocales ?? locales;
const locale = (Astro.currentLocale || defaultLocale) as "en" | "fr" | "ja";
const siteTitle = uiStrings.siteTitle[locale] || "Artus Mosquet";
const defaultDescription =
  uiStrings.siteDescription?.[locale] ||
  "Personal website of Artus Mosquet, Full-Time ECE Student at Purdue University.";


const cleanTitleText = cleanText(title);
const fullTitle = cleanTitleText
  ? cleanTitleText.includes(siteTitle)
    ? cleanTitleText
    : `${cleanTitleText} | ${siteTitle}`
  : siteTitle;

const cleanDesc = cleanText(description) || defaultDescription;

const siteUrl = Astro.site?.href ?? "https://artusmosquet.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

let imageUrl: string;
if (image) {
  if (image.startsWith("http://") || image.startsWith("https://")) {
    imageUrl = image;
  } else {
    imageUrl = new URL(image.startsWith("/") ? image : `/${image}`, siteUrl).href;
  }
} else {
  imageUrl = new URL("/og-image.png", siteUrl).href;
}

const ogLocaleMap: Record<string, string> = {
  en: "en_US",
  fr: "fr_FR",
  ja: "ja_JP",
};

const currentOgLocale = ogLocaleMap[locale] || "en_US";
const alternateOgLocales = activeLocales
  .filter((l) => l !== locale)
  .map((l) => ogLocaleMap[l])
  .filter(Boolean);

const hreflangMap: Record<string, string> = {
  en: "en",
  fr: "fr",
  ja: "ja",
};

function getLocalizedPath(targetLocale: string): string {
  const rawPathname = Astro.url.pathname;
  const pathname = rawPathname.endsWith("/") ? rawPathname : `${rawPathname}/`;
  if (pathname.startsWith(`/${locale}/`)) {
    return pathname.replace(new RegExp(`^/${locale}/`), `/${targetLocale}/`);
  }
  if (pathname === "/" || pathname === "") {
    return `/${targetLocale}/`;
  }
  return `/${targetLocale}${pathname.startsWith("/") ? pathname : "/" + pathname}`;
}

const xDefaultLocale = activeLocales.includes(defaultLocale)
  ? defaultLocale
  : (activeLocales[0] || locale);

const baseSiteOrigin = new URL("/", siteUrl).href.replace(/\/$/, "");
const personId = `${baseSiteOrigin}/#person`;
const websiteId = `${baseSiteOrigin}/#website`;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: "Artus Mosquet",
  alternateName: ["モスケ アルテゥス", "アルテゥス・モスケ"],
  url: `${baseSiteOrigin}/en/`,
  image: `${baseSiteOrigin}/og-image.png`,
  jobTitle: cleanText(uiStrings.myOccupation?.[locale]) || "Full-Time ECE Student",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Purdue University",
    url: "https://www.purdue.edu/",
  },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Purdue University",
      url: "https://www.purdue.edu/",
    },
  ],
  sameAs: [
    "https://github.com/amosquet",
    "https://www.linkedin.com/in/artusmosquet",
    "https://twitter.com/almondmanttv",
    "https://twitch.tv/almondmanttv",
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  name: siteTitle,
  alternateName: "Artus Mosquet",
  url: `${baseSiteOrigin}/`,
  inLanguage: activeLocales,
  author: { "@id": personId },
  publisher: { "@id": personId },
};

const normalizedPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isProfilePage =
  /^\/(en|fr|ja)\/$/.test(normalizedPath) ||
  /^\/(en|fr|ja)\/about\/$/.test(normalizedPath);

let pageEntitySchema: Record<string, unknown>;
if (type === "article" && article) {
  pageEntitySchema = {
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    headline: cleanTitleText || siteTitle,
    description: cleanDesc,
    url: canonicalUrl,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    image: [imageUrl],
    inLanguage: locale,
    author: { "@id": personId },
    publisher: { "@id": personId },
    isPartOf: { "@id": websiteId },
    ...(article.publishedTime ? { datePublished: article.publishedTime } : {}),
    ...(article.modifiedTime || article.publishedTime
      ? { dateModified: article.modifiedTime || article.publishedTime }
      : {}),
    ...(article.tags && article.tags.length > 0
      ? { keywords: article.tags.map((t) => cleanText(t)) }
      : {}),
  };
} else if (type === "book" && book) {
  pageEntitySchema = {
    "@type": "WebPage",
    "@id": canonicalUrl,
    url: canonicalUrl,
    name: fullTitle,
    description: cleanDesc,
    inLanguage: locale,
    isPartOf: { "@id": websiteId },
    mainEntity: {
      "@type": "Book",
      name: cleanTitleText || fullTitle,
      image: imageUrl,
      ...(book.author
        ? { author: { "@type": "Person", name: cleanText(book.author) } }
        : {}),
      ...(book.isbn ? { isbn: book.isbn } : {}),
    },
  };
} else {
  pageEntitySchema = {
    "@type": isProfilePage ? "ProfilePage" : "WebPage",
    "@id": canonicalUrl,
    url: canonicalUrl,
    name: fullTitle,
    description: cleanDesc,
    inLanguage: locale,
    isPartOf: { "@id": websiteId },
    ...(isProfilePage ? { mainEntity: { "@id": personId } } : { about: { "@id": personId } }),
  };
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, pageEntitySchema],
};
---

{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Multilingual alternate hreflang tags -->
{
  activeLocales.map((l) => {
    const langCode = hreflangMap[l] || l;
    const localizedHref = new URL(getLocalizedPath(l), siteUrl).href;
    return <link rel="alternate" hreflang={langCode} href={localizedHref} />;
  })
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(getLocalizedPath(xDefaultLocale), siteUrl).href}
/>

<!-- Standard Meta Tags -->
<meta name="description" content={cleanDesc} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteTitle} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={cleanDesc} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={currentOgLocale} />
{
  alternateOgLocales.map((altLocale) => (
    <meta property="og:locale:alternate" content={altLocale} />
  ))
}

<!-- Article Open Graph Tags -->
{
  type === "article" && article && (
    <>
      {article.publishedTime && (
        <meta
          property="article:published_time"
          content={article.publishedTime}
        />
      )}
      {article.modifiedTime && (
        <meta
          property="article:modified_time"
          content={article.modifiedTime}
        />
      )}
      {article.author && (
        <meta property="article:author" content={cleanText(article.author)} />
      )}
      {article.tags &&
        article.tags.map((tag) => (
          <meta property="article:tag" content={cleanText(tag)} />
        ))}
    </>
  )
}

<!-- Book Open Graph Tags -->
{
  type === "book" && book && (
    <>
      {book.author && (
        <meta property="book:author" content={cleanText(book.author)} />
      )}
      {book.isbn && <meta property="book:isbn" content={book.isbn} />}
    </>
  )
}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={cleanDesc} />
<meta name="twitter:image" content={imageUrl} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
