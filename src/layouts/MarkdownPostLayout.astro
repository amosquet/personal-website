---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { defaultLocale, type Locale } from "@/i18n/i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
    frontmatter: {
        title: string;
        description?: string;
        pubDate: Date | string;
        updatedDate?: Date | string;
        heroImage?: string;
        location?: string;
        tags?: string[];
    };
    lang?: Locale;
    slug?: string;
}

const { frontmatter, lang, slug } = Astro.props;
const currentLang = lang || Astro.currentLocale || defaultLocale;
const t = useTranslations(currentLang);

const ogImage = frontmatter.heroImage || (slug ? `/${currentLang}/blog/${slug}/og.png` : undefined);

const dateLocale = currentLang === "jp" ? "ja-JP" : currentLang === "fr" ? "fr-FR" : "en-US";
const dateObj = new Date(frontmatter.pubDate);
const formattedDate = !isNaN(dateObj.getTime())
    ? new Intl.DateTimeFormat(dateLocale, {
          year: "numeric",
          month: "long",
          day: "numeric",
      }).format(dateObj)
    : String(frontmatter.pubDate);

const updatedDateObj = frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : null;
const formattedUpdatedDate =
    updatedDateObj && !isNaN(updatedDateObj.getTime())
        ? new Intl.DateTimeFormat(dateLocale, {
              year: "numeric",
              month: "long",
              day: "numeric",
          }).format(updatedDateObj)
        : frontmatter.updatedDate
          ? String(frontmatter.updatedDate)
          : null;

const isoPublishedTime = !isNaN(dateObj.getTime()) ? dateObj.toISOString() : undefined;
const isoModifiedTime = updatedDateObj && !isNaN(updatedDateObj.getTime()) ? updatedDateObj.toISOString() : undefined;
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    image={ogImage}
    type="article"
    article={{
        publishedTime: isoPublishedTime,
        modifiedTime: isoModifiedTime,
        author: t("siteTitle"),
        tags: frontmatter.tags,
    }}
>
    <div class="max-w-3xl mx-auto px-4 py-12">
        <a
            href={`/${currentLang}/blog`}
            class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 mb-8 inline-flex items-center gap-2 transition-colors font-medium text-sm"
        >
            ← {t("backToBlog")}
        </a>

        <article>
            <header class="mb-8">
                <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-50 mb-3 tracking-tight">
                    {frontmatter.title}
                </h1>

                <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-4">
                    <time datetime={!isNaN(dateObj.getTime()) ? dateObj.toISOString() : undefined}>
                        {t("publishDate")} {formattedDate}
                    </time>
                    {
                        formattedUpdatedDate && (
                            <>
                                <span>&bull;</span>
                                <time
                                    datetime={
                                        updatedDateObj && !isNaN(updatedDateObj.getTime())
                                            ? updatedDateObj.toISOString()
                                            : undefined
                                    }
                                >
                                    {t("updatedDate")} {formattedUpdatedDate}
                                </time>
                            </>
                        )
                    }
                    {
                        frontmatter.location && (
                            <>
                                <span>&bull;</span>
                                <span class="inline-flex items-center gap-1">
                                    <Icon name="mdi:map-marker-outline" class="w-4 h-4 text-gray-400 dark:text-gray-500" />
                                    <span>{frontmatter.location}</span>
                                </span>
                            </>
                        )
                    }
                    <span>&bull;</span>
                    <span>{t("writtenBy")} {t("siteTitle")}</span>
                </div>

                {frontmatter.tags && frontmatter.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                        {frontmatter.tags.map((tag) => (
                            <span class="text-xs px-2.5 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full font-medium">
                                #{tag}
                            </span>
                        ))}
                    </div>
                )}

                {frontmatter.description && (
                    <p class="text-lg text-gray-600 dark:text-gray-400 italic border-l-4 border-gray-300 dark:border-gray-600 pl-4 py-1">
                        {frontmatter.description}
                    </p>
                )}

                {frontmatter.heroImage && (
                    <img
                        src={frontmatter.heroImage}
                        alt={`Hero for ${frontmatter.title}`}
                        class="w-full h-auto mt-6 shadow-sm border border-gray-200 dark:border-gray-700"
                    />
                )}
            </header>

            <hr class="border-gray-200 dark:border-gray-700 mb-8" />

            <div class="prose-content">
                <slot />
            </div>
        </article>
    </div>
</Layout>

<style>
    .prose-content :global(h2) {
        font-size: 1.5rem;
        font-weight: 700;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        color: #111827;
        letter-spacing: -0.01em;
    }
    .prose-content :global(h3) {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: #1f2937;
    }
    .prose-content :global(p) {
        margin-bottom: 1.25rem;
        line-height: 1.8;
        color: #374151;
        font-size: 1.05rem;
    }
    .prose-content :global(ul) {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
        line-height: 1.75;
        color: #374151;
    }
    .prose-content :global(ol) {
        list-style-type: decimal;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
        line-height: 1.75;
        color: #374151;
    }
    .prose-content :global(li) {
        margin-bottom: 0.35rem;
    }
    .prose-content :global(blockquote) {
        border-left: 4px solid #d1d5db;
        padding-left: 1rem;
        font-style: italic;
        color: #4b5563;
        margin: 1.5rem 0;
    }
    .prose-content :global(code) {
        background-color: #f3f4f6;
        padding: 0.15rem 0.35rem;
        border-radius: 0.25rem;
        font-size: 0.9em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    .prose-content :global(pre) {
        background-color: #1e1e1e;
        color: #f3f4f6;
        padding: 1.25rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
        font-size: 0.9rem;
        line-height: 1.6;
    }
    .prose-content :global(pre code) {
        background-color: transparent;
        padding: 0;
        border-radius: 0;
        color: inherit;
    }
    .prose-content :global(a) {
        color: #2563eb;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .prose-content :global(a:hover) {
        color: #1d4ed8;
    }
    .prose-content :global(hr) {
        margin: 2rem 0;
        border-color: #e5e7eb;
    }
    .prose-content :global(img) {
        max-width: 100%;
        height: auto;
        margin: 1.5rem 0;
    }

    /* Dark mode prose overrides */
    :global([data-theme="dark"]) .prose-content :global(h2) { color: #f3f4f6; }
    :global([data-theme="dark"]) .prose-content :global(h3) { color: #e5e7eb; }
    :global([data-theme="dark"]) .prose-content :global(p) { color: #d1d5db; }
    :global([data-theme="dark"]) .prose-content :global(ul) { color: #d1d5db; }
    :global([data-theme="dark"]) .prose-content :global(ol) { color: #d1d5db; }
    :global([data-theme="dark"]) .prose-content :global(blockquote) {
        border-left-color: #4b5563;
        color: #9ca3af;
    }
    :global([data-theme="dark"]) .prose-content :global(code) {
        background-color: #1f2937;
        color: #e5e7eb;
    }
    :global([data-theme="dark"]) .prose-content :global(a) { color: #60a5fa; }
    :global([data-theme="dark"]) .prose-content :global(a:hover) { color: #93c5fd; }
    :global([data-theme="dark"]) .prose-content :global(hr) { border-color: #374151; }
</style>