---
const { frontmatter } = Astro.props;
import Layout from '@/layouts/Layout.astro';

import { defaultLocale } from "@/i18n/i18n";
const locale = Astro.currentLocale || defaultLocale;
import { useTranslations } from '@/i18n/utils';
const t = useTranslations(locale);

// Format the date in ISO8601 format
const formattedDate = frontmatter.pubDate ? new Date(frontmatter.pubDate).toISOString() : undefined;
const modifiedDate = frontmatter.updatedDate ? new Date(frontmatter.updatedDate).toISOString() : undefined;
---

<Layout
    title={frontmatter.title}
    description={frontmatter.description}
    image={frontmatter.image?.url || frontmatter.image}
    type="article"
    article={{
        publishedTime: formattedDate,
        modifiedTime: modifiedDate,
        author: frontmatter.author || t("siteTitle"),
        tags: frontmatter.tags,
    }}
>
    <style>
        h1 {
            text-align: center;
            font-size: 40px;
            font-weight: bold;
        }
    
        p {
            text-align: center;
            margin-top: 0.5rem;
            font-size: 20px;
        }

        article {
            margin: 0 auto;
            margin-top: 6rem;
            max-width: 800px;
            padding: 1rem;
            font-size: 15px;
        }
    </style>
    <meta charset="utf-8" />
    <h1>{frontmatter.title}</h1>
    <p>{t("publishDate")} {formattedDate}</p>
    <p>{t("writtenBy")} {t("siteTitle")}</p>
    <article><slot /></article>
</Layout>