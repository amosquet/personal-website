---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { defaultLocale } from "@/i18n/i18n";
import { useTranslations } from "@/i18n/utils";

const locale = Astro.currentLocale || defaultLocale;
const t = useTranslations(locale);

export interface Props {
    intro: {
        title: string;
        description: string;
    };
    experience: {
        title: string;
        items: Array<{
            role: string;
            company: string;
            date: string;
            bullets?: string[];
            description?: string;
        }>;
    };
    education: {
        title: string;
        items: Array<{
            institution: string;
            details: string;
        }>;
    };
    skills: {
        title: string;
        categories: Array<{
            name: string;
            list: string;
        }>;
    };
    projects: {
        title: string;
        items: Array<{
            name: string;
            description: string;
            theme: "purple" | "green" | "blue" | "orange";
        }>;
    };
}

const { intro, experience, education, skills, projects } = Astro.props;

// Pre-defining Tailwind classes prevents them from being purged at build time
const themeStyles = {
    purple: {
        wrapper: "bg-purple-50 dark:bg-purple-950 border-purple-100 dark:border-purple-900",
        title: "text-purple-800 dark:text-purple-300",
        desc: "text-purple-600 dark:text-purple-400",
    },
    green: {
        wrapper: "bg-green-50 dark:bg-green-950 border-green-100 dark:border-green-900",
        title: "text-green-800 dark:text-green-300",
        desc: "text-green-600 dark:text-green-400",
    },
    blue: {
        wrapper: "bg-blue-50 dark:bg-blue-950 border-blue-100 dark:border-blue-900",
        title: "text-blue-800 dark:text-blue-300",
        desc: "text-blue-600 dark:text-blue-400",
    },
    orange: {
        wrapper: "bg-orange-50 dark:bg-orange-950 border-orange-100 dark:border-orange-900",
        title: "text-orange-800 dark:text-orange-300",
        desc: "text-orange-600 dark:text-orange-400",
    },
};

const ogImage = `/${locale}/about/og.png`;
---

<Layout title={intro.title} description={intro.description} image={ogImage}>
    <div class="max-w-4xl mx-auto py-8 px-4 flex flex-col gap-12">
        {/* Introduction Section */}
        <section>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
                <h2 class="text-3xl font-bold" set:html={intro.title} />
                <a
                    href="/Artus_Mosquet_Resume.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-3.5 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-600 shadow-2xs hover:border-gray-300 dark:hover:border-gray-500 transition-colors w-fit shrink-0"
                >
                    <Icon
                        name="mdi:file-document-outline"
                        class="w-4 h-4 text-blue-600 dark:text-blue-400"
                    />
                    <span set:html={t("viewResume")} />
                    <Icon
                        name="mdi:arrow-top-right"
                        class="w-3.5 h-3.5 text-gray-400 dark:text-gray-500"
                    />
                </a>
            </div>
            <p class="text-lg text-gray-700 dark:text-gray-300" set:html={intro.description} />
        </section>

        {/* Experience Section */}
        <section>
            <h2
                class="text-2xl font-semibold mb-6 border-b-2 border-gray-200 dark:border-gray-700 pb-2"
                set:html={experience.title}
            />
            <div class="flex flex-col gap-6">
                {experience.items.map((item) => (
                    <div class="bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2 gap-2">
                            <h3
                                class="text-xl font-medium"
                                set:html={item.role}
                            />
                            <span
                                class="text-sm bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 py-1 px-3"
                                set:html={`${item.company} | ${item.date}`}
                            />
                        </div>
                        {item.bullets ? (
                            <ul class="list-disc list-inside text-gray-600 dark:text-gray-400 space-y-1">
                                {item.bullets.map((bullet) => (
                                    <li set:html={bullet} />
                                ))}
                            </ul>
                        ) : (
                            <p
                                class="text-gray-600 dark:text-gray-400"
                                set:html={item.description}
                            />
                        )}
                    </div>
                ))}
            </div>
        </section>

        {/* Education & Skills Section */}
        <section>
            <div class="grid md:grid-cols-2 gap-8 items-start">
                <div>
                    <h2
                        class="text-2xl font-semibold mb-6 border-b-2 border-gray-200 dark:border-gray-700 pb-2"
                        set:html={education.title}
                    />
                    <div class="bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                        {education.items.map((item) => (
                            <div class="mb-4 last:mb-0">
                                <h3
                                    class="font-medium text-lg"
                                    set:html={item.institution}
                                />
                                <p
                                    class="text-gray-600 dark:text-gray-400"
                                    set:html={item.details}
                                />
                            </div>
                        ))}
                    </div>
                </div>

                <div>
                    <h2
                        class="text-2xl font-semibold mb-6 border-b-2 border-gray-200 dark:border-gray-700 pb-2"
                        set:html={skills.title}
                    />
                    <div class="bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                        {skills.categories.map((category) => (
                            <div class="mb-4 last:mb-0">
                                <h4
                                    class="font-medium text-gray-800 dark:text-gray-200"
                                    set:html={category.name}
                                />
                                <p
                                    class="text-gray-600 dark:text-gray-400 text-sm"
                                    set:html={category.list}
                                />
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        {/* Projects Section */}
        <section>
            <h2
                class="text-2xl font-semibold mb-6 border-b-2 border-gray-200 dark:border-gray-700 pb-2"
                set:html={projects.title}
            />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {projects.items.map((project) => (
                    <div
                        class={`p-4 border hover:shadow-md transition-shadow ${themeStyles[project.theme].wrapper}`}
                    >
                        <h3
                            class={`font-medium ${themeStyles[project.theme].title}`}
                            set:html={project.name}
                        />
                        <p
                            class={`text-sm mt-1 ${themeStyles[project.theme].desc}`}
                            set:html={project.description}
                        />
                    </div>
                ))}
            </div>
        </section>
    </div>
</Layout>
